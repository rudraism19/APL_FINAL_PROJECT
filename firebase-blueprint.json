{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User account information, roles, and gamification metrics",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the user"
        },
        "email": {
          "type": "string",
          "description": "The user email coordinate"
        },
        "role": {
          "type": "string",
          "enum": ["donor", "receiver"],
          "description": "Role of the user in the ecosystem"
        },
        "points": {
          "type": "integer",
          "description": "Impact or motivation points accumulated"
        },
        "badges": {
          "type": "array",
          "description": "Gamified achievement badges unlocked"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp of the user account"
        }
      },
      "required": ["name", "email", "role"]
    },
    "donation": {
      "title": "Donation",
      "description": "A food surplus listing uploaded by a donor",
      "type": "object",
      "properties": {
        "foodName": {
          "type": "string",
          "description": "Name of the food item"
        },
        "quantity": {
          "type": "string",
          "description": "Quantity and unit of the surplus food"
        },
        "expiryTime": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp indicating safety timeline limit"
        },
        "pickupAddress": {
          "type": "string",
          "description": "Physical pickup coordinates"
        },
        "contactNumber": {
          "type": "string",
          "description": "Contact phone for hand-off"
        },
        "imageUrl": {
          "type": "string",
          "description": "Base64 payload or public media path of the food"
        },
        "freshnessScore": {
          "type": "string",
          "description": "Freshness estimation index (e.g. 92/100)"
        },
        "status": {
          "type": "string",
          "enum": ["Available", "Reserved", "Collected"],
          "description": "Redistribution lifecycle state"
        },
        "donorId": {
          "type": "string",
          "description": "User ID of the donating entity"
        },
        "donorName": {
          "type": "string",
          "description": "Cached display name of the donor"
        },
        "receiverId": {
          "type": "string",
          "description": "User ID of the claiming receiver"
        },
        "aiAnalysis": {
          "type": "object",
          "description": "Gemini-extracted visual food verification results"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of upload"
        }
      },
      "required": ["foodName", "quantity", "expiryTime", "pickupAddress", "contactNumber", "status", "donorId", "donorName"]
    },
    "claim": {
      "title": "Claim Record",
      "description": "Transactional log of food listings claimed",
      "type": "object",
      "properties": {
        "donationId": {
          "type": "string",
          "description": "ID of the associated donation"
        },
        "receiverId": {
          "type": "string",
          "description": "ID of the user who claimed"
        },
        "donorId": {
          "type": "string",
          "description": "ID of the offering donor"
        },
        "status": {
          "type": "string",
          "enum": ["Reserved", "Collected"],
          "description": "Hand-off status"
        },
        "claimedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when claimed"
        }
      },
      "required": ["donationId", "receiverId", "donorId", "status"]
    },
    "impact_stat": {
      "title": "Impact Stat",
      "description": "Ecosystem aggregated visual analytics",
      "type": "object",
      "properties": {
        "mealsSaved": {
          "type": "integer",
          "description": "Equivalent servings redistributed"
        },
        "foodRescuedKg": {
          "type": "number",
          "description": "Estimated aggregate weight of food rescued"
        },
        "co2PreventedKg": {
          "type": "number",
          "description": "Estimated carbon offset equivalent saved"
        }
      },
      "required": ["mealsSaved", "foodRescuedKg", "co2PreventedKg"]
    },
    "notification": {
      "title": "Notification",
      "description": "Ecosystem real-time notifications for interactions",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The target recipient user ID"
        },
        "message": {
          "type": "string",
          "description": "Informatical alert message"
        },
        "read": {
          "type": "boolean",
          "description": "Interaction status indicator"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of creation"
        }
      },
      "required": ["userId", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles and impact aggregate statistics"
    },
    "/donations/{donationId}": {
      "schema": "donation",
      "description": "Surplus food items listings feed"
    },
    "/claims/{claimId}": {
      "schema": "claim",
      "description": "Individual listings claimed for pickup tracking"
    },
    "/impact_stats/{statId}": {
      "schema": "impact_stat",
      "description": "System-wide real-time live aggregates and metrics"
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "User real-time system alert items"
    }
  }
}
