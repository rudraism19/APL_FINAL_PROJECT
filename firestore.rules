rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation blueprints for entity writes
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && (data.role == 'donor' || data.role == 'receiver');
    }

    function isValidDonation(data) {
      return data.keys().hasAll(['foodName', 'quantity', 'expiryTime', 'pickupAddress', 'contactNumber', 'status', 'donorId', 'donorName'])
        && data.foodName is string && data.foodName.size() <= 150
        && data.quantity is string && data.quantity.size() <= 50
        && data.pickupAddress is string && data.pickupAddress.size() <= 255
        && data.contactNumber is string && data.contactNumber.size() <= 30
        && (data.status == 'Available' || data.status == 'Reserved' || data.status == 'Collected')
        && data.donorId is string && data.donorId.size() <= 128;
    }

    function isValidClaim(data) {
      return data.keys().hasAll(['donationId', 'receiverId', 'donorId', 'status'])
        && data.donationId is string && data.donationId.size() <= 128
        && data.receiverId is string && data.receiverId.size() <= 128
        && data.donorId is string && data.donorId.size() <= 128
        && (data.status == 'Reserved' || data.status == 'Collected');
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'message', 'read'])
        && data.userId is string && data.userId.size() <= 128
        && data.message is string && data.message.size() <= 255
        && data.read is bool;
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow list, delete: if false;
    }

    // Collection: Donations
    match /donations/{donationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(donationId)
        && isValidDonation(incoming())
        && incoming().donorId == request.auth.uid;
      
      allow update: if isSignedIn()
        && isValidId(donationId)
        && isValidDonation(incoming())
        && (
          // Action 1: Donor updates their own post (e.g. status)
          (existing().donorId == request.auth.uid && incoming().donorId == request.auth.uid) ||
          // Action 2: Receiver claims the post (modifies status & receiverId)
          (existing().status == 'Available' && incoming().status == 'Reserved' && incoming().receiverId == request.auth.uid) ||
          // Action 3: Receiver/Donor transitions to Collected
          (incoming().status == 'Collected' && (existing().receiverId == request.auth.uid || existing().donorId == request.auth.uid))
        );
      allow delete: if isSignedIn() && existing().donorId == request.auth.uid && existing().status == 'Available';
    }

    // Collection: Claims
    match /claims/{claimId} {
      allow get: if isSignedIn() && (existing().receiverId == request.auth.uid || existing().donorId == request.auth.uid);
      allow list: if isSignedIn(); // Queries must filter by receiverId or donorId
      allow create: if isSignedIn()
        && isValidId(claimId)
        && isValidClaim(incoming())
        && incoming().receiverId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(claimId)
        && isValidClaim(incoming())
        && (existing().receiverId == request.auth.uid || existing().donorId == request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Collection: Impact Stats (publicly readable aggregates)
    match /impact_stats/{statId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collection: Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn(); // Filtering is required in app queries
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
